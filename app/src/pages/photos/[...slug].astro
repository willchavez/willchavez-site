---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { getPhotos, fmtDate, img } from "../../lib/content";
export async function getStaticPaths() {
  return (await getPhotos()).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const d = entry.data;
const meta = [fmtDate(d.date), d.place].filter(Boolean).join(" · ");
---
<Base title={d.title ?? "Photo"} current="photos" heading={d.title ?? "Photo"} sub={meta} description={d.caption}>
  <a class="back" href="/photos"><svg class="icon-arrow-left" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M12.5 8h-9m0 0 4-4m-4 4 4 4" /></svg>Back to Photos</a>
  <img class="photo-full" src={img(d.image, 1600)} srcset={`${img(d.image, 960)} 960w, ${img(d.image, 1600)} 1600w`} sizes="(max-width: 900px) 100vw, 62rem" alt={d.alt ?? d.title ?? ""} decoding="async" />
  {d.caption && <p class="caption">{d.caption}</p>}
</Base>
