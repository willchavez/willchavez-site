---
import Base from "../../layouts/Base.astro";
import Empty from "../../components/Empty.astro";
import { getPhotos, img } from "../../lib/content";
const photos = await getPhotos();
---
<Base title="Photos" current="photos" heading="Photos" sub="pictures i took" description="Photos by Will Chavez">
  <div class="section">
    <span class="section-label">Photos</span>
    {photos.length === 0 ? (
      <Empty line="no photos yet. the first one is coming" hint="a photo i loved, with a line about it. they'll land here as a grid, newest first." />
    ) : (
      <div class="grid">
        {photos.map((p) => (
          <a href={`/photos/${p.id}`} aria-label={p.data.title ?? p.data.alt ?? "photo"}>
            <img src={img(p.data.image, 480)} srcset={`${img(p.data.image, 480)} 480w, ${img(p.data.image, 960)} 960w`} sizes="(max-width: 640px) 50vw, 220px" alt={p.data.alt ?? p.data.title ?? ""} loading="lazy" decoding="async" />
          </a>
        ))}
      </div>
    )}
  </div>
</Base>
