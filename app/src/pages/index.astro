---
import Base from "../layouts/Base.astro";
import "../styles/work.css";
import CompanyLogo from "../components/CompanyLogo.astro";
---
<Base title="Will Chavez is a design engineer." titleExact current="work" showHeading={false} description="Will Chavez is a design technologist at Microsoft, working on generative AI interfaces, design systems, and tools for designers.">
  <div class="work-page" data-direction="split">
    <header class="work-intro">
      <span class="work-eyebrow"><span class="work-dot" aria-hidden="true"></span> Design Technologist <span class="work-pronouns">· He/him</span></span>
      <h1>Will Chavez</h1>
      <p class="work-lead">AI interfaces and thoughtful tools for designers are at the center of my work.</p>
      <p class="work-summary">I’m a Design Technologist in Microsoft’s Fluent Design Studio, working on AI experiences and design systems.</p>
      <a class="work-contact" href="mailto:wchavezsalinas@gmail.com">Get in touch <svg class="icon-arrow" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M4 12 12 4M5 4h7v7" /></svg></a>
    </header>

    <section class="work-experience" aria-labelledby="experience-title">
      <h2 class="work-section-title" id="experience-title">My experience</h2>
      <article class="work-role">
        <div class="work-company"><CompanyLogo company="microsoft" /><h3>Microsoft</h3><span class="work-period">Current</span></div>
        <div class="work-description">
          <section class="work-team-section" aria-labelledby="team-fluent">
            <h4 class="work-team" id="team-fluent">Fluent Design Studio</h4>
            <p class="work-role-meta">2021–Present · Senior UX Engineer since 2023</p>
            <p>At Fluent, I work with design, product, and engineering teams to prototype AI-powered interfaces and interaction patterns.</p>
            <p>That work also includes tools and automated workflows for Fluent icons and emoji, from Figma exports to asset comparisons and release reporting.</p>
          </section>
          <section class="work-team-section" aria-labelledby="team-security">
            <h4 class="work-team" id="team-security">Secure Admin Services</h4>
            <p class="work-role-meta">Software Engineer II · 2020–2021</p>
            <p>On the SASWEB team, I helped modernize internal security tools through front-end experiences.</p>
          </section>
        </div>
      </article>
      <article class="work-role">
        <div class="work-company"><CompanyLogo company="ibm" /><h3>IBM</h3></div>
        <div class="work-description">
          <section class="work-team-section" aria-labelledby="team-garage">
            <h4 class="work-team" id="team-garage">Cloud Garage</h4>
            <p class="work-role-meta">Software Engineer II · 2018–2020</p>
            <p>At the Garage, I led software projects with startups and teams across design and engineering, grounding the work in the IBM Garage Method and design thinking.</p>
          </section>
          <section class="work-team-section" aria-labelledby="team-watson">
            <h4 class="work-team" id="team-watson">Watson</h4>
            <p class="work-role-meta">Software Engineer · 2016–2018</p>
            <p>The work included full-stack experiences for Watson Company Profiler and Watson Assistant, plus integrations with Slack and Facebook Messenger.</p>
          </section>
        </div>
      </article>
      <article class="work-role">
        <div class="work-company"><CompanyLogo company="lockheed-martin" /><h3>Lockheed Martin</h3></div>
        <div class="work-description">
          <section class="work-team-section" aria-labelledby="team-research">
            <h4 class="work-team" id="team-research">Research &amp; Development</h4>
            <p class="work-role-meta">Software Engineer · 2015–2016</p>
            <p>The work included pilot logistics systems, with my first chance to test mobile apps alongside real users at Air Force bases.</p>
          </section>
        </div>
      </article>
    </section>

    <footer class="work-footer">
      <p>For selected project work, <a href="mailto:wchavezsalinas@gmail.com?subject=Portfolio%20request">email me</a>.</p>
      <p>Outside of work, I make music, take photos, and keep learning. <a href="/about">More about me</a>.</p>
    </footer>
  </div>
</Base>
<script is:inline data-astro-rerun>
{
  // Temporary branch previews: same content, three visual directions.
  const direction = new URLSearchParams(location.search).get("direction");
  if (["rounded", "quiet", "split"].includes(direction)) {
    document.querySelector(".work-page").dataset.direction = direction;
  }
}
</script>
