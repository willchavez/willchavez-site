---
import Base from "../layouts/Base.astro";
import "../styles/work.css";
---
<Base title="Work" current="work" showHeading={false} description="Will Chavez is a design technologist at Microsoft, working on generative AI interfaces, design systems, and tools for designers.">
  <div class="work-page" data-direction="rounded">
    <header class="work-intro">
      <span class="work-eyebrow"><span class="work-dot" aria-hidden="true"></span> Design technologist <span class="work-pronouns">· He/him</span></span>
      <h1>Will Chavez</h1>
      <p class="work-lead">I prototype AI interfaces and build tools for designers.</p>
      <p class="work-summary">I’m a design technologist in Microsoft’s Fluent Design Studio. I work on generative AI experiences and design systems.</p>
      <a class="work-contact" href="mailto:wchavezsalinas@gmail.com">Get in touch <span aria-hidden="true">↗</span></a>
    </header>

    <section class="work-experience" aria-labelledby="experience-title">
      <h2 class="work-section-title" id="experience-title">My experience</h2>
      <article class="work-role">
        <div class="work-company"><h3>Microsoft</h3><span class="work-period">Current</span></div>
        <div class="work-description">
          <p class="work-team">Fluent Design Studio</p>
          <p>My work includes Copilot interfaces, shared icon and emoji libraries, and tools that help designers build and maintain them.</p>
          <p class="work-secondary">Earlier at Microsoft, I worked on experiences for the digital security and risk engineering team.</p>
        </div>
      </article>
      <article class="work-role">
        <div class="work-company"><h3>IBM</h3></div>
        <div class="work-description">
          <p class="work-team">IBM Garage &amp; Watson Assistant</p>
          <p>I built an education analytics platform with IBM Garage and third-party integrations for Watson Assistant.</p>
        </div>
      </article>
      <article class="work-role">
        <div class="work-company"><h3>Lockheed Martin</h3></div>
        <div class="work-description">
          <p class="work-team">Research &amp; development</p>
          <p>I worked on research and development projects.</p>
        </div>
      </article>
    </section>

    <footer class="work-footer">
      <p>For selected project work, <a href="mailto:wchavezsalinas@gmail.com?subject=Portfolio%20request">email me</a>.</p>
      <p>Outside of work, I make music, take photos, and keep learning. <a href="/about">More about me</a>.</p>
    </footer>
  </div>
</Base>
<script is:inline>
  // Temporary branch previews: same content, three visual directions.
  const direction = new URLSearchParams(location.search).get("direction");
  if (["rounded", "quiet", "split"].includes(direction)) {
    document.querySelector(".work-page").dataset.direction = direction;
  }
</script>
