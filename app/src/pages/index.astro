---
import { contentExcerpt } from "../lib/excerpt";
import CompanyLogo from "../components/CompanyLogo.astro";
import Base from "../layouts/Base.astro";
import "../styles/home.css";
import { portfolioProjects } from "../data/portfolio-projects";
import { getWriting, getEnjoying, portfolioImg, img, fmtDate } from "../lib/content";
const featured = ["genui-bebop", "bebop", "hireharlem"].map(slug => portfolioProjects.find(p => p.slug === slug)!);
const notes = (await getWriting()).slice(0, 2);
const enjoying = (await getEnjoying()).filter(p => p.body?.trim()).slice(0, 2);

---
<Base title="Will Chavez is a design engineer." titleExact current="work" showHeading={false} description="Will Chavez builds AI interfaces, tools for designers, and small projects that start with a question.">
  <div class="home-page">
    <header class="home-intro">
      <div class="home-hello">
        <p class="home-kicker">Will Chavez · Design technologist</p>
        <h1>I make ideas<br />you can click on.</h1>
      </div>
      <div class="home-intro-aside">
        <p class="home-summary">I’m Will. At Microsoft, I build AI interfaces and tools for designers.</p>
        <p class="home-personal">Outside of work, it’s synths, music, and whatever I’m trying to figure out this week.</p>
        <div class="home-actions"><a class="home-button" href="#selected-work">See my work</a><a href="mailto:wchavezsalinas@gmail.com">Get in touch</a></div>
      </div>
    </header>
    <section class="home-section" id="selected-work" aria-labelledby="selected-title">
      <div class="home-section-head"><h2 id="selected-title">A few things I’ve made</h2><a href="/portfolio">All projects</a></div>
      <div class="home-projects">
        {featured.map((p, index) => <a class="home-project" href={`/portfolio/${p.slug}`}>
          <div class:list={["home-project-image", `home-image-${p.slug}`]}><img src={portfolioImg(p.slug === "bebop" ? "img/portfolio/bebop/zoomedout.gif" : p.cover, 960)} alt={p.slug === "bebop" ? "Copilot prototype with a canvas of project notes" : p.images[0].alt} loading={index === 0 ? "eager" : "lazy"} decoding="async" /></div>
          <div class="home-project-copy"><span class="home-kicker">{p.category}</span><h3>{p.title}</h3><p>{p.summary}</p></div>
        </a>)}
      </div>
    </section>
    <section class="home-history" aria-labelledby="history-title">
      <div class="home-section-head"><h2 id="history-title">Where I’ve been</h2><a href="/about#experience">My full experience</a></div>
      <div class="home-companies">
        <article class="home-company">
          <div class="home-company-heading"><CompanyLogo company="microsoft" /><h3>Microsoft</h3></div>
          <p class="home-company-dates">2020–now · Current</p>
          <p class="home-company-role">Senior UX Engineer</p>
          <p>Prototyping AI experiences and building tools for designers in Fluent Design Studio.</p>
        </article>
        <article class="home-company">
          <div class="home-company-heading"><CompanyLogo company="ibm" /><h3>IBM</h3></div>
          <p class="home-company-dates">2016–2020</p>
          <p class="home-company-role">Software Engineer II</p>
          <p>Working with startups at Cloud Garage and building conversational experiences with Watson.</p>
        </article>
        <article class="home-company">
          <div class="home-company-heading"><CompanyLogo company="lockheed-martin" /><h3>Lockheed Martin</h3></div>
          <p class="home-company-dates">2015–2016</p>
          <p class="home-company-role">Software Engineer</p>
          <p>Building pilot logistics systems and testing mobile apps with the people using them.</p>
        </article>
      </div>
    </section>
    <div class="home-journal">
      <section class="home-section home-notes-section" aria-labelledby="home-notes">
        <div class="home-section-head"><h2 id="home-notes">Notes</h2><a href="/notes">All notes</a></div>
        <p class="home-section-description">Things I’m making, learning, and figuring out.</p>
        {notes.map(n => <a class="home-note" href={`/notes/${n.id}`}><time datetime={n.data.date.toISOString()}>{fmtDate(n.data.date)}</time><h3>{n.data.title}</h3><p>{n.data.summary}</p></a>)}
      </section>
      <section class="home-section home-enjoying-section" aria-labelledby="home-enjoying">
        <div class="home-section-head"><h2 id="home-enjoying">Enjoying</h2><a href="/enjoying">All picks</a></div>
        <p class="home-section-description">Music, films, and books I’ve spent time with.</p>
        {enjoying.map(e => <a class="home-enjoying" href={`/enjoying/${e.id}`}>{e.data.cover && <img class="home-pick-cover" src={img(e.data.cover, 240)} alt="" width="64" height="64" loading="lazy" decoding="async" />}<div class="home-pick-copy"><span class="home-kicker">{e.data.kind}{e.data.creator && ` · ${e.data.creator}`}</span><h3>{e.data.title}</h3><p>{contentExcerpt(e.body)}</p></div></a>)}
      </section>
    </div>
    <div class="home-closing"><p>Have something you want to make?</p><a href="mailto:wchavezsalinas@gmail.com">Let’s talk about it</a></div>
  </div>
</Base>
