---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import SoundCloud from "../../components/SoundCloud.astro";
import { soundCloudURL } from "../../lib/soundcloud.mjs";
import { getEnjoying, fmtDate, img } from "../../lib/content";
export async function getStaticPaths() {
  return (await getEnjoying()).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const meta = [d.kind, d.creator, d.year, d.date && fmtDate(d.date)].filter(Boolean).join(" · ");
const stars = d.rating && (Number.isInteger(d.rating) ? "★".repeat(d.rating) + "☆".repeat(5 - d.rating) : "★".repeat(Math.floor(d.rating)) + "½");
const youtubeId = d.kind === "music" && d.link?.match(/(?:youtube\.com\/watch\?v=|youtu\.be\/)([A-Za-z0-9_-]{11})/)?.[1];
---
<Base title={d.title} current="enjoying" heading={d.title} sub={meta} description={`${d.title}${d.creator ? ", " + d.creator : ""}`}>
  <a class="back" href="/enjoying">Back to Enjoying</a>
  {d.cover && <img class="photo-full" style="max-width:18rem;margin-bottom:1.4rem" src={img(d.cover, 960)} alt="" decoding="async" />}
  {d.rating && <div class="rating byline" aria-label={`${d.rating} out of 5`}>{stars}</div>}
  <div class="prose"><Content /></div>
  {youtubeId && <div class="youtube-embed"><iframe src={`https://www.youtube-nocookie.com/embed/${youtubeId}`} title={d.title} loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen /></div>}
  <SoundCloud url={d.link} title={d.title} />
  {d.link && !soundCloudURL(d.link) && !youtubeId && <p class="byline" style="margin-top:1.4rem"><a href={d.link}>Open link</a></p>}
</Base>

<style>
  .youtube-embed { width: min(100%, 48rem); aspect-ratio: 16 / 9; margin-top: 1.5rem; overflow: hidden; border-radius: 1rem; background: var(--ink); }
  .youtube-embed iframe { display: block; width: 100%; height: 100%; border: 0; }
</style>
