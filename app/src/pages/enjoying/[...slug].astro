---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import SoundCloud from "../../components/SoundCloud.astro";
import { soundCloudURL } from "../../lib/soundcloud.mjs";
import { getEnjoying, fmtDate, img, KIND_PLURAL } from "../../lib/content";
export async function getStaticPaths() {
  return (await getEnjoying()).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const displayDate = d.date ?? d.releaseDate;
const secondaryMeta = [d.publication, d.year, displayDate && `${d.date ? "" : "Released "}${fmtDate(displayDate)}`].filter(Boolean).join(" · ");
const meta = d.kind === "paper" ? undefined : [d.creator, secondaryMeta].filter(Boolean).join(" · ");
const stars = d.rating && (Number.isInteger(d.rating) ? "★".repeat(d.rating) + "☆".repeat(5 - d.rating) : "★".repeat(Math.floor(d.rating)) + "½");
const youtubeId = d.kind === "music" && d.link?.match(/(?:youtube\.com\/watch\?v=|youtu\.be\/)([A-Za-z0-9_-]{11})/)?.[1];
const filterLabels = Object.fromEntries([
  ["all", "All"],
  ...Object.entries(KIND_PLURAL).map(([kind, label]) => [kind, label.charAt(0).toUpperCase() + label.slice(1)]),
]);
---
<Base title={d.title} current="enjoying" heading={d.title} sub={meta ?? d.creator} subAfter={d.kind === "paper" ? secondaryMeta : undefined} subKind={d.kind} compactTitle description={`${d.title}${d.creator ? ", " + d.creator : ""}`}>
  <a class="back" href={`/enjoying#${d.kind}`} data-enjoying-back data-kind={d.kind} data-filter-labels={JSON.stringify(filterLabels)}><svg class="icon-arrow-left" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M12.5 8h-9m0 0 4-4m-4 4 4 4" /></svg><span class="back-label">Back to {filterLabels[d.kind]}</span></a>
  {d.cover && !youtubeId && <img class:list={["photo-full", d.kind === "paper" && "paper-page"]} style="max-width:18rem;margin-bottom:1.4rem" src={img(d.cover, 480)} srcset={d.cover.startsWith("/uploads/") ? `${img(d.cover, 240)} 240w, ${img(d.cover, 480)} 480w` : undefined} sizes="18rem" alt={d.kind === "paper" ? `First page of ${d.title}` : ""} width={d.kind === "paper" ? 800 : undefined} height={d.kind === "paper" ? 1035 : undefined} loading="lazy" decoding="async" />}
  {d.rating && <div class="rating byline" aria-label={`${d.rating} out of 5`}>{stars}</div>}
  <div class="prose"><Content /></div>
  {youtubeId && <div class="youtube-embed"><iframe src={`https://www.youtube-nocookie.com/embed/${youtubeId}`} title={d.title} loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen /></div>}
  <SoundCloud url={d.link} title={d.title} />
  {d.link && !soundCloudURL(d.link) && !youtubeId && <p class="byline" style="margin-top:1.4rem"><a href={d.link}>Open link</a></p>}
</Base>

<script>
  const scrollPositionKey = "enjoying:list-scroll-position";
  const restorePositionKey = "enjoying:restore-list-scroll-position";
  addEventListener("popstate", () => {
    if (document.querySelector("[data-enjoying-back]") && sessionStorage.getItem(scrollPositionKey)) {
      sessionStorage.setItem(restorePositionKey, "true");
    }
  });
  document.addEventListener("astro:page-load", () => {
    const back = document.querySelector<HTMLAnchorElement>("[data-enjoying-back]");
    if (!back) return;
    back.addEventListener("click", () => sessionStorage.setItem(restorePositionKey, "true"), { once: true });
    const labels: Record<string, string> = JSON.parse(back.dataset.filterLabels!);
    const from = new URLSearchParams(location.search).get("from");
    const kind = from && Object.hasOwn(labels, from) ? from : back.dataset.kind!;
    const label = back.querySelector<HTMLElement>(".back-label");
    if (label) label.textContent = `Back to ${labels[kind]}`;
    back.href = kind === "all" ? "/enjoying" : `/enjoying#${kind}`;
  });
</script>

<style>
  .youtube-embed { width: min(100%, 48rem); aspect-ratio: 16 / 9; margin-top: 1.5rem; overflow: hidden; border-radius: 1rem; background: var(--ink); }
  .youtube-embed iframe { display: block; width: 100%; height: 100%; border: 0; }
  .photo-full.paper-page { display: block; width: min(100%, 24rem); max-width: 24rem !important; height: auto; object-fit: contain; }
</style>
