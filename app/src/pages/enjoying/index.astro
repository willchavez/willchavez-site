---
import Base from "../../layouts/Base.astro";
import Empty from "../../components/Empty.astro";
import SoundCloud from "../../components/SoundCloud.astro";
import { getEnjoying, fmtDate, img, KIND_PLURAL } from "../../lib/content";
import { KINDS } from "../../content.config";
const items = await getEnjoying();
const nextCount = items.filter((i) => i.data.status === "up next").length;
const doneCount = items.length - nextCount;
const stars = (n: number) => Number.isInteger(n) ? "★".repeat(n) + "☆".repeat(5 - n) : "★".repeat(Math.floor(n)) + "½";
const kindCount = (kind: string) => items.filter((i) => i.data.status === "enjoyed" && i.data.kind === kind).length;
---
<Base showPageTitle={false} title="Enjoying" current="enjoying" heading="Enjoying" sub="Music, films, games, books, and papers I’m spending time with." description="What Will Chavez is enjoying, and what's up next">
  <div class="section">
    <div>
      <div class="chips" role="group" aria-label="enjoyed or up next">
        <button class="chip" type="button" data-status="enjoyed" aria-pressed="true">Enjoyed{doneCount ? ` · ${doneCount}` : ""}</button>
        <button class="chip" type="button" data-status="up next" aria-pressed="false">Up next{nextCount ? ` · ${nextCount}` : ""}</button>
      </div>
      <div class="chips" role="group" aria-label="filter by type" id="kinds">
        <button class="chip" type="button" data-kind="all" aria-pressed="true">All<span class="chip-count" data-count aria-hidden="true" hidden={doneCount === 0}>{doneCount || ""}</span></button>
        {KINDS.map((k) => {
          const count = kindCount(k);
          return <button class="chip" type="button" data-kind={k} aria-pressed="false">{KIND_PLURAL[k].charAt(0).toUpperCase() + KIND_PLURAL[k].slice(1)}<span class="chip-count" data-count aria-hidden="true" hidden={count === 0}>{count || ""}</span></button>;
        })}
      </div>

      <div id="list">
        {items.map((i) => (
          <div class="ent" data-status={i.data.status} data-kind={i.data.kind}>
            {i.data.cover
              ? <img class="cover" src={img(i.data.cover, 240)} alt="" loading="lazy" decoding="async" />
              : <div class="cover cover-empty" aria-hidden="true" />}
            <div class="ent-copy">
              <div class="ent-heading">
                <span class="k">{i.data.kind}</span>
              {i.data.status === "enjoyed"
                ? <a class="t" href={`/enjoying/${i.id}`}>{i.data.title}</a>
                : i.data.link ? <a class="t" href={i.data.link}>{i.data.title}</a> : <span class="t">{i.data.title}</span>}
                {i.data.date && <time class="recorded" datetime={i.data.date.toISOString()}>{fmtDate(i.data.date)}</time>}
              </div>
              <span class="m">{[i.data.creator, i.data.year].filter(Boolean).join(" · ")}</span>
              {i.data.rating && <div class="rating" aria-label={`${i.data.rating} out of 5`}>{stars(i.data.rating)}</div>}
              <SoundCloud url={i.data.link} title={i.data.title} />
            </div>
          </div>
        ))}
      </div>

      <Empty attrs={{ id: "empty-enjoyed", hidden: true }} line="Nothing here yet." hint="I’ll collect things I’ve enjoyed, with a few words when I have something to say." />
      <Empty attrs={{ id: "empty-next", hidden: true }} line="My queue is empty." hint="Things I want to listen to, watch, play, or read will appear here." />
      <Empty attrs={{ id: "empty-filter", hidden: true }} line="Nothing matches these filters yet." />
    </div>
  </div>
</Base>
<script>
  let cleanup = () => {};
  document.addEventListener("astro:page-load", () => {
  cleanup();
  if (!document.querySelector("#kinds")) return;
  const controller = new AbortController();
  cleanup = () => controller.abort();
  // enjoyed / up next, plus type filter. state lives in the URL hash so it can be linked.
  const rows = [...document.querySelectorAll<HTMLElement>(".ent")];
  const statusBtns = [...document.querySelectorAll<HTMLButtonElement>("[data-status].chip")];
  const kindBtns = [...document.querySelectorAll<HTMLButtonElement>("[data-kind].chip")];
  const countFor = (kind: string) => rows.filter((r) => r.dataset.status === status && (kind === "all" || r.dataset.kind === kind)).length;
  const updateCounts = () => kindBtns.forEach((button) => {
    const count = countFor(button.dataset.kind || "all");
    const badge = button.querySelector<HTMLElement>("[data-count]");
    if (badge) { badge.textContent = count ? String(count) : ""; badge.hidden = count === 0; }
  });
  const show = (id: string, on: boolean) => { const el = document.getElementById(id); if (el) el.hidden = !on; };
  let status = "enjoyed", kind = "all";
  const fromHash = () => {
    const h = decodeURIComponent(location.hash.slice(1));
    const [s, k] = h.split("/");
    if (s === "next" || s === "up next") status = "up next"; else status = "enjoyed";
    kind = k || "all";
  };
  const apply = () => {
    let shown = 0;
    rows.forEach((r) => {
      const ok = r.dataset.status === status && (kind === "all" || r.dataset.kind === kind);
      r.hidden = !ok; if (ok) shown++;
    });
    statusBtns.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.status === status)));
    kindBtns.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.kind === kind)));
    updateCounts();
    const inStatus = rows.filter((r) => r.dataset.status === status).length;
    show("empty-enjoyed", inStatus === 0 && status === "enjoyed");
    show("empty-next", inStatus === 0 && status === "up next");
    show("empty-filter", inStatus > 0 && shown === 0);
  };
  const push = () => history.replaceState(history.state, "", `#${status === "up next" ? "next" : "enjoyed"}${kind === "all" ? "" : "/" + kind}`);
  statusBtns.forEach((b) => b.addEventListener("click", () => { status = b.dataset.status!; push(); apply(); }));
  kindBtns.forEach((b) => b.addEventListener("click", () => { kind = b.dataset.kind!; push(); apply(); }));
  addEventListener("hashchange", () => { fromHash(); apply(); }, { signal: controller.signal });
  fromHash(); apply();
  });
</script>
