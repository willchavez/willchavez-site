---
import { contentExcerpt } from "../../lib/excerpt";
import EnjoyingHeading from "../../components/EnjoyingHeading.astro";
import Base from "../../layouts/Base.astro";
import ViewToggle from "../../components/ViewToggle.astro";
import "../../styles/enjoying-layout.css";
import Empty from "../../components/Empty.astro";
import SoundCloud from "../../components/SoundCloud.astro";
import { getEnjoying, img, KIND_PLURAL } from "../../lib/content";
import { KINDS } from "../../content.config";
const items = await getEnjoying();
const kindCount = (kind: string) => items.filter((i) => i.data.kind === kind).length;
const tilePattern = ["lead", "compact", "visual", "text", "compact", "visual", "lead", "compact"];
---
<Base showPageTitle={false} title="Enjoying" current="enjoying" heading="Enjoying" sub="Music, films, books, and papers I’ve spent time with." description="What Will Chavez has been enjoying">
  <div class="section">
    <div>
      <div class="enjoying-toolbar">
        <div class="enjoying-filters">
          <div class="chips" role="group" aria-label="Filter by type" id="kind-tabs">
            <button class="chip" type="button" data-kind="all" data-label="All" aria-pressed="true">All<span class="chip-count" data-count hidden={items.length === 0}>{items.length || ""}</span></button>
            {KINDS.map((k) => {
              const count = kindCount(k);
              const label = KIND_PLURAL[k].charAt(0).toUpperCase() + KIND_PLURAL[k].slice(1);
              return <button class="chip" type="button" data-kind={k} data-label={label} aria-pressed="false">{label}<span class="chip-count" data-count hidden={count === 0}>{count || ""}</span></button>;
            })}
          </div>

          <details class="enjoying-kind-menu" id="kind-menu">
            <summary aria-label="Filter enjoying items by type">
              <span id="kind-current">All</span>
              <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="m4 6 4 4 4-4" /></svg>
            </summary>
            <div class="enjoying-kind-options" role="group" aria-label="Filter by type">
              <button class="chip" type="button" data-kind="all" data-label="All" aria-pressed="true">All<span class="chip-count" data-count hidden={items.length === 0}>{items.length || ""}</span></button>
              {KINDS.map((k) => {
                const count = kindCount(k);
                const label = KIND_PLURAL[k].charAt(0).toUpperCase() + KIND_PLURAL[k].slice(1);
                return <button class="chip" type="button" data-kind={k} data-label={label} aria-pressed="false">{label}<span class="chip-count" data-count hidden={count === 0}>{count || ""}</span></button>;
              })}
            </div>
          </details>
        </div>
        <ViewToggle label="Enjoying layout" className="enjoying-view-toggle" hidden />
      </div>

      <div id="enjoying-results" data-kind="all" data-view="list">
      <div id="list">
        {items.map((i, index) => {
          return (
          <div class="ent" data-kind={i.data.kind} data-tile={tilePattern[index % tilePattern.length]}>
            {i.data.cover
              ? <a class="cover-link" href={`/enjoying/${i.id}?from=all`} data-enjoying-entry aria-label={`View ${i.data.title}`}><img class="cover" src={img(i.data.cover, 240)} srcset={i.data.cover.startsWith("/uploads/") ? `${img(i.data.cover, 240)} 240w, ${img(i.data.cover, 480)} 480w, ${img(i.data.cover, 960)} 960w` : undefined} sizes="(max-width: 699px) 90vw, 50vw" alt="" loading="lazy" decoding="async" /></a>
              : <div class="cover cover-empty" aria-hidden="true" />}
            <div class="ent-copy">
              <EnjoyingHeading data={i.data} href={`/enjoying/${i.id}?from=all`} />
              {contentExcerpt(i.body) && <p class="ent-excerpt">{contentExcerpt(i.body)}</p>}
              <SoundCloud url={i.data.link} title={i.data.title} />
            </div>
          </div>
          );
        })}
      </div>

      <Empty attrs={{ id: "empty-list", hidden: true }} line="Nothing here yet." hint="I’ll collect things I’ve enjoyed, with a few words when I have something to say." />
      <Empty attrs={{ id: "empty-filter", hidden: true }} line="Nothing matches these filters yet." />
      </div>
    </div>
  </div>
</Base>
<script>
  import { initEnjoyingLayout } from "../../scripts/enjoying-layout";
  let cleanup = () => {};
  let activeResults: HTMLElement | null = null;
  const initFilters = () => {
  const nextResults = document.getElementById("enjoying-results");
  if (nextResults === activeResults) return;
  cleanup();
  activeResults = nextResults;
  if (!nextResults) return;
  const results = nextResults;
  const controller = new AbortController();
  const layout = initEnjoyingLayout(results);
  cleanup = () => {
    controller.abort();
    layout.destroy();
  };
  const scrollPositionKey = "enjoying:list-scroll-position";
  const restorePositionKey = "enjoying:restore-list-scroll-position";
  // Type filter state lives in the URL hash so it can be linked.
  const rows = [...document.querySelectorAll<HTMLElement>(".ent")];
  const kindBtns = [...document.querySelectorAll<HTMLButtonElement>("[data-kind].chip")];
  const kindMenu = document.getElementById("kind-menu") as HTMLDetailsElement | null;
  const validKinds = new Set(kindBtns.map((b) => b.dataset.kind || "all"));
  const show = (id: string, on: boolean) => { const el = document.getElementById(id); if (el) el.hidden = !on; };
  let kind = "all";
  let requestedKind = kind;
  const fromHash = () => {
    const h = decodeURIComponent(location.hash.slice(1));
    // Accept old #enjoyed/type and #next/type links, but keep new links short.
    const candidate = h.includes("/") ? h.split("/").at(-1)! : h;
    kind = validKinds.has(candidate) ? candidate : "all";
  };
  const apply = () => {
    results.dataset.kind = kind;
    let shown = 0;
    rows.forEach((r) => {
      const ok = kind === "all" || r.dataset.kind === kind;
      r.hidden = !ok; if (ok) shown++;
      r.querySelectorAll<HTMLAnchorElement>("[data-enjoying-entry]").forEach((entry) => {
        const url = new URL(entry.href);
        url.searchParams.set("from", kind);
        entry.href = url.pathname + url.search;
      });
    });
    kindBtns.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.kind === kind)));
    const currentLabel = document.getElementById("kind-current");
    if (currentLabel) currentLabel.textContent = kindBtns.find((b) => b.dataset.kind === kind)?.dataset.label || "All";
    show("empty-list", rows.length === 0);
    show("empty-filter", rows.length > 0 && shown === 0);
  };
  const push = () => history.replaceState(history.state, "", kind === "all" ? `${location.pathname}${location.search}` : `#${kind}`);
  const select = async (next: string) => {
    if (next === requestedKind) return;
    requestedKind = next;
    await layout.change(() => { kind = next; push(); apply(); });
  };
  kindBtns.forEach((b) => b.addEventListener("click", (event) => {
    if (b.closest("#kind-menu") && kindMenu) {
      if (event.detail > 0) b.blur();
      kindMenu.open = false;
    }
    select(b.dataset.kind!);
  }, { signal: controller.signal }));
  document.addEventListener("click", (event) => {
    const link = event.target instanceof Element ? event.target.closest<HTMLAnchorElement>("a[href]") : null;
    if (!link) return;
    if (link.matches("[data-enjoying-entry]")) {
      sessionStorage.setItem(scrollPositionKey, JSON.stringify({ top: window.scrollY, kind, path: location.pathname }));
    } else {
      sessionStorage.removeItem(scrollPositionKey);
      sessionStorage.removeItem(restorePositionKey);
    }
  }, { capture: true, signal: controller.signal });
  if (kindMenu) {
    addEventListener("click", (event) => {
      if (kindMenu.open && !kindMenu.contains(event.target as Node)) kindMenu.open = false;
    }, { signal: controller.signal });
    addEventListener("keydown", (event) => {
      if (event.key === "Escape" && kindMenu.open) {
        kindMenu.open = false;
        kindMenu.querySelector("summary")?.focus();
      }
    }, { signal: controller.signal });
  }
  addEventListener("hashchange", () => {
    void layout.change(() => { fromHash(); requestedKind = kind; apply(); });
  }, { signal: controller.signal });
  fromHash(); requestedKind = kind;
  void layout.change(apply, false);
  if (sessionStorage.getItem(restorePositionKey) === "true") {
    sessionStorage.removeItem(restorePositionKey);
    const savedPosition = sessionStorage.getItem(scrollPositionKey);
    sessionStorage.removeItem(scrollPositionKey);
    if (savedPosition) {
      try {
        const { top, kind: savedKind, path } = JSON.parse(savedPosition) as { top: number; kind: string; path: string };
        if (path === location.pathname && savedKind === kind && Number.isFinite(top)) {
          void document.fonts.ready.then(() => requestAnimationFrame(() => requestAnimationFrame(() => window.scrollTo(0, top))));
        }
      } catch {
        // Ignore invalid or stale session data.
      }
    }
  }
  };
  document.addEventListener("astro:before-swap", () => { cleanup(); activeResults = null; });
  document.addEventListener("astro:page-load", initFilters);
  initFilters();
</script>
