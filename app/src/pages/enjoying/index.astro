---
import Base from "../../layouts/Base.astro";
import Empty from "../../components/Empty.astro";
import SoundCloud from "../../components/SoundCloud.astro";
import { getEnjoying, fmtDate, img, KIND_PLURAL } from "../../lib/content";
import { KINDS } from "../../content.config";
const items = await getEnjoying();
const stars = (n: number) => Number.isInteger(n) ? "★".repeat(n) + "☆".repeat(5 - n) : "★".repeat(Math.floor(n)) + "½";
const kindCount = (kind: string) => items.filter((i) => i.data.kind === kind).length;
---
<Base showPageTitle={false} title="Enjoying" current="enjoying" heading="Enjoying" sub="Music, films, games, books, and papers I’ve spent time with." description="What Will Chavez has been enjoying">
  <div class="section">
    <div>
      <div class="chips" role="group" aria-label="filter by type" id="kinds">
        <button class="chip" type="button" data-kind="all" aria-pressed="true">All<span class="chip-count" data-count hidden={items.length === 0}>{items.length || ""}</span></button>
        {KINDS.map((k) => {
          const count = kindCount(k);
          return <button class="chip" type="button" data-kind={k} aria-pressed="false">{KIND_PLURAL[k].charAt(0).toUpperCase() + KIND_PLURAL[k].slice(1)}<span class="chip-count" data-count hidden={count === 0}>{count || ""}</span></button>;
        })}
      </div>

      <div id="enjoying-results">
      <div id="list">
        {items.map((i) => {
          const displayDate = i.data.date ?? i.data.releaseDate;
          return (
          <div class="ent" data-kind={i.data.kind}>
            {i.data.cover
              ? <img class="cover" src={img(i.data.cover, 240)} alt="" loading="lazy" decoding="async" />
              : <div class="cover cover-empty" aria-hidden="true" />}
            <div class="ent-copy">
              <div class="ent-heading">
                <div class="ent-titleline">
                  <span class="k">{i.data.kind}</span>
                  <a class="t" href={`/enjoying/${i.id}?from=all`} data-enjoying-entry>{i.data.title}</a>
                </div>
                {displayDate && <time class="recorded" datetime={displayDate.toISOString()} title={i.data.date ? undefined : "U.S. public release date"}>{!i.data.date && "Released "}{fmtDate(displayDate)}</time>}
              </div>
              <span class="m">{[i.data.creator, i.data.year].filter(Boolean).join(" · ")}</span>
              {i.data.rating && <div class="rating" aria-label={`${i.data.rating} out of 5`}>{stars(i.data.rating)}</div>}
              <SoundCloud url={i.data.link} title={i.data.title} />
            </div>
          </div>
          );
        })}
      </div>

      <Empty attrs={{ id: "empty-list", hidden: true }} line="Nothing here yet." hint="I’ll collect things I’ve enjoyed, with a few words when I have something to say." />
      <Empty attrs={{ id: "empty-filter", hidden: true }} line="Nothing matches these filters yet." />
      </div>
    </div>
  </div>
</Base>
<script>
  let cleanup = () => {};
  document.addEventListener("astro:page-load", () => {
  cleanup();
  if (!document.querySelector("#kinds")) return;
  const controller = new AbortController();
  const results = document.getElementById("enjoying-results")!;
  cleanup = () => {
    controller.abort();
    results.getAnimations().forEach((animation) => animation.cancel());
  };
  const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)");
  // Type filter state lives in the URL hash so it can be linked.
  const rows = [...document.querySelectorAll<HTMLElement>(".ent")];
  const kindBtns = [...document.querySelectorAll<HTMLButtonElement>("[data-kind].chip")];
  const validKinds = new Set(kindBtns.map((b) => b.dataset.kind || "all"));
  const show = (id: string, on: boolean) => { const el = document.getElementById(id); if (el) el.hidden = !on; };
  let kind = "all";
  let requestedKind = kind;
  let changeId = 0;
  const fromHash = () => {
    const h = decodeURIComponent(location.hash.slice(1));
    // Accept old #enjoyed/type and #next/type links, but keep new links short.
    const candidate = h.includes("/") ? h.split("/").at(-1)! : h;
    kind = validKinds.has(candidate) ? candidate : "all";
  };
  const apply = () => {
    let shown = 0;
    rows.forEach((r) => {
      const ok = kind === "all" || r.dataset.kind === kind;
      r.hidden = !ok; if (ok) shown++;
      const entry = r.querySelector<HTMLAnchorElement>("[data-enjoying-entry]");
      if (entry) {
        const url = new URL(entry.href);
        url.searchParams.set("from", kind);
        entry.href = url.pathname + url.search;
      }
    });
    kindBtns.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.kind === kind)));
    show("empty-list", rows.length === 0);
    show("empty-filter", rows.length > 0 && shown === 0);
  };
  const push = () => history.replaceState(history.state, "", kind === "all" ? `${location.pathname}${location.search}` : `#${kind}`);
  const resetAnimation = () => {
    results.classList.remove("is-entering", "is-leaving");
    results.getAnimations().forEach((animation) => animation.cancel());
  };
  const select = async (next: string) => {
    if (next === requestedKind) return;
    requestedKind = next;
    const request = ++changeId;
    resetAnimation();
    if (!reducedMotion.matches) {
      results.classList.add("is-leaving");
      await Promise.allSettled(results.getAnimations().map((animation) => animation.finished));
    }
    if (request !== changeId || controller.signal.aborted) return;
    kind = next;
    push(); apply();
    results.classList.remove("is-leaving");
    if (!reducedMotion.matches) results.classList.add("is-entering");
  };
  kindBtns.forEach((b) => b.addEventListener("click", () => select(b.dataset.kind!)));
  addEventListener("hashchange", () => {
    ++changeId; resetAnimation();
    fromHash(); requestedKind = kind; apply();
  }, { signal: controller.signal });
  fromHash(); requestedKind = kind; apply();
  });
</script>
<style>
  #enjoying-results.is-leaving { animation: var(--content-exit-animation); }
  #enjoying-results.is-entering { animation: var(--content-enter-animation); }
</style>
