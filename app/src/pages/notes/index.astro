---
import Base from "../../layouts/Base.astro";
import Empty from "../../components/Empty.astro";
import { getWriting, fmtDate, img } from "../../lib/content";
const posts = await getWriting();
---
<Base showPageTitle={false} title="Notes" current="notes" heading="Notes" sub="Thoughts, things I’m learning, and occasional longer posts." description="Notes by Will Chavez">
  <div class="section note-index">
    {posts.length === 0 ? (
      <Empty line="No notes yet." hint="I’ll add something here when I have a thought to share." />
    ) : (
      <ol class="entries note-list">
        {posts.map((p) => (
          <li class:list={["note-card", !p.data.thumbnail && "note-card-text"]}>
            {p.data.thumbnail && <div class="note-thumb"><img src={img(p.data.thumbnail, 480)} alt="" loading="lazy" decoding="async" /></div>}
            <div class="note-card-copy">
              <div class="note-card-heading">
                <a class="t" href={`/notes/${p.id}`}>{p.data.title}</a>
                <span class="m">{fmtDate(p.data.date)}</span>
              </div>
              {p.data.summary && <div class="s">{p.data.summary}</div>}
              {p.data.topics.length > 0 && <ul class="note-topics" aria-label={`Topics for ${p.data.title}`}>
                {p.data.topics.map((topic) => <li class="note-topic">{topic}</li>)}
              </ul>}
            </div>
          </li>
        ))}
      </ol>
    )}
  </div>
</Base>
