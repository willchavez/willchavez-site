---
import Base from "../../layouts/Base.astro";
import Empty from "../../components/Empty.astro";
import { getWriting, fmtDate } from "../../lib/content";
const posts = await getWriting();
---
<Base title="Notes" current="notes" heading="Notes" sub="notes, half-ideas, longer posts" description="Notes by Will Chavez">
  <div class="section">
    <span class="section-label">notes</span>
    {posts.length === 0 ? (
      <Empty line="nothing here yet. notes will land here when i have something to share" hint="short thoughts, things i'm learning, and occasional longer posts." />
    ) : (
      <ol class="entries">
        {posts.map((p) => (
          <li>
            <a class="t" href={`/notes/${p.id}`}>{p.data.title}</a>
            <span class="m">{fmtDate(p.data.date)}</span>
            {p.data.summary && <div class="s">{p.data.summary}</div>}
          </li>
        ))}
      </ol>
    )}
  </div>
</Base>
