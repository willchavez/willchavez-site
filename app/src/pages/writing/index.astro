---
import Base from "../../layouts/Base.astro";
import Empty from "../../components/Empty.astro";
import { getWriting, fmtDate } from "../../lib/content";
const posts = await getWriting();
---
<Base title="Writing" current="writing" heading="Writing" sub="notes, half-ideas, longer posts" description="Writing by Will Chavez">
  <div class="section">
    <span class="section-label">Writing</span>
    {posts.length === 0 ? (
      <Empty line="nothing here yet. the first post is on its way" hint="when there are posts they'll show up here, newest first. there's an rss feed too." />
    ) : (
      <ol class="entries">
        {posts.map((p) => (
          <li>
            <a class="t" href={`/writing/${p.id}`}>{p.data.title}</a>
            <span class="m">{fmtDate(p.data.date)}</span>
            {p.data.summary && <div class="s">{p.data.summary}</div>}
          </li>
        ))}
      </ol>
    )}
  </div>
</Base>
