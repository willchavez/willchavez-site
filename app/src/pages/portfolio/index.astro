---
import Base from "../../layouts/Base.astro";
import ViewToggle from "../../components/ViewToggle.astro";
import "../../styles/portfolio.css";
import { portfolioProjects } from "../../data/portfolio-projects";
import { portfolioImg } from "../../lib/content";

const projectOrder = ["genui-bebop", "bebop", "fluent-asset-library", "fluent-dataviz", "agent-builder", "nav2", "icon-scaling-tool", "visual-diff"];
const projects = [
  ...projectOrder.map((slug) => portfolioProjects.find((project) => project.slug === slug)!).filter(Boolean),
  ...portfolioProjects.filter((project) => !projectOrder.some((slug) => slug === project.slug)),
];
const featured = new Set(["genui-bebop", "bebop"]);
const categories = [
  { id: "all", label: "All projects" },
  { id: "ai-experiences", label: "AI experiences", category: "AI experiences" },
  { id: "design-tooling", label: "Design tooling", category: "Design tooling" },
  { id: "research-learning", label: "Research & learning", category: "Research & learning" },
  { id: "community", label: "Community", category: "Community" },
];
const countFor = (category?: string) => category ? projects.filter((project) => project.category === category).length : projects.length;
---
<Base title="Projects" current="portfolio" heading="Projects" showHeading={false} description="Selected design engineering and design technology projects by Will Chavez.">
  <div class="portfolio-page">
    <section class="portfolio-intro">
      <div>
        <h1>Selected<br />collaborations</h1>
      </div>
      <p>Prototypes, design tools, and websites I’ve helped shape with teams and communities.</p>
    </section>

    <div class="portfolio-toolbar">
      <div class="portfolio-filters">
        <div class="chips" role="group" aria-label="Filter projects" id="kind-tabs">
          {categories.map((filter) => <button class="chip" type="button" data-kind={filter.id} data-label={filter.label} aria-pressed={filter.id === "all" ? "true" : "false"}>{filter.label}<span class="chip-count" data-count>{countFor(filter.category)}</span></button>)}
        </div>
        <details class="enjoying-kind-menu" id="kind-menu">
          <summary aria-label="Filter projects by type">
            <span id="kind-current">All projects</span>
            <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="m4 6 4 4 4-4" /></svg>
          </summary>
          <div class="enjoying-kind-options" role="group" aria-label="Filter projects">
            {categories.map((filter) => <button class="chip" type="button" data-kind={filter.id} data-label={filter.label} aria-pressed={filter.id === "all" ? "true" : "false"}>{filter.label}<span class="chip-count" data-count>{countFor(filter.category)}</span></button>)}
          </div>
        </details>
      </div>
      <ViewToggle label="Project layout" className="portfolio-view-toggle" />
    </div>

    <div id="portfolio-results" data-kind="all" data-view="grid">
      <section class="portfolio-grid" aria-label="Selected projects">
        {projects.map((project) => (
          <article class:list={["portfolio-card", "interactive-card", featured.has(project.slug) && "featured"]} data-category={project.category} data-project={project.slug}>
            <a class="project-open" href={`/portfolio/${project.slug}`} aria-label={`Explore ${project.title}`}>
              <div class="project-image">
                <img src={portfolioImg(project.cover, 480)} srcset={`${portfolioImg(project.cover, 480)} 480w, ${portfolioImg(project.cover, 960)} 960w`} sizes="(max-width: 520px) 100vw, (max-width: 820px) 50vw, 33vw" alt={project.images[0]?.alt ?? project.title} loading="lazy" decoding="async" />
                <span class="explore" aria-hidden="true">View project</span>
              </div>
              <div class="project-info">
                <div class="portfolio-eyebrow">{project.org}</div>
                <h2>{project.title}</h2>
                <p>{project.summary}</p>
                <div class="skills" aria-label="Project tags">{project.tags.map((tag) => <span class="skill-tag">{tag}</span>)}</div>
              </div>
            </a>
          </article>
        ))}
      </section>
    </div>
    <div class="portfolio-closing">
      <p>Made with designers, engineers, and a lot of iteration.</p>
      <a href="mailto:wchavezsalinas@gmail.com">Let’s talk about the work</a>
    </div>
  </div>
</Base>

<script>
  import { createCardMotion } from "../../scripts/card-motion";
  let cleanup = () => {};
  document.addEventListener("astro:page-load", () => {
    cleanup();
    const results = document.getElementById("portfolio-results");
    if (!results) return;
    const controller = new AbortController();
    const cards = [...results.querySelectorAll<HTMLElement>(".portfolio-card")];
    const motion = createCardMotion(results, results.querySelector<HTMLElement>(".portfolio-grid")!, cards, {
      enabled: () => matchMedia("(min-width: 641px)").matches,
    });
    cleanup = () => {
      controller.abort();
      motion.destroy();
    };
    const buttons = [...document.querySelectorAll<HTMLButtonElement>("[data-kind].chip")];
    const layoutButtons = [...document.querySelectorAll<HTMLButtonElement>("[data-layout-choice]")];
    const mobileViewport = matchMedia("(max-width: 640px)");
    const kindMenu = document.getElementById("kind-menu") as HTMLDetailsElement | null;
    const validKinds = new Set(buttons.map((button) => button.dataset.kind || "all"));
    let kind = "all";
    let requestedKind = kind;
    const fromHash = () => {
      const candidate = decodeURIComponent(location.hash.slice(1));
      kind = validKinds.has(candidate) ? candidate : "all";
    };
    const apply = () => {
      results.dataset.kind = kind;
      const category = categoriesForKind[kind];
      cards.forEach((card) => {
        card.hidden = kind !== "all" && card.dataset.category !== category;
      });
      buttons.forEach((button) => button.setAttribute("aria-pressed", String(button.dataset.kind === kind)));
      const label = buttons.find((button) => button.dataset.kind === kind)?.dataset.label || "All projects";
      const current = document.getElementById("kind-current");
      if (current) current.textContent = label;
    };
    let desktopView: "grid" | "list" = "grid";
    const applyLayout = (view = desktopView) => {
      if (!mobileViewport.matches) desktopView = view;
      const activeView = mobileViewport.matches ? "list" : desktopView;
      results.dataset.view = activeView;
      layoutButtons.forEach((choice) => choice.setAttribute("aria-pressed", String(choice.dataset.layoutChoice === activeView)));
    };
    layoutButtons.forEach((button) => button.addEventListener("click", () => {
      motion.cancel(); applyLayout(button.dataset.layoutChoice === "list" ? "list" : "grid");
    }, { signal: controller.signal }));
    mobileViewport.addEventListener("change", () => { motion.cancel(); applyLayout(); }, { signal: controller.signal });
    addEventListener("resize", () => motion.cancel(), { signal: controller.signal });
    applyLayout();
    const categoriesForKind: Record<string, string | undefined> = {
      "ai-experiences": "AI experiences",
      "design-tooling": "Design tooling",
      "research-learning": "Research & learning",
      community: "Community",
    };
    const push = () => history.replaceState(history.state, "", kind === "all" ? `${location.pathname}${location.search}` : `#${kind}`);
    const select = (next: string) => {
      if (next === requestedKind) return;
      requestedKind = next;
      void motion.change(() => { kind = next; push(); apply(); });
    };
    buttons.forEach((button) => button.addEventListener("click", (event) => {
      if (button.closest("#kind-menu") && kindMenu) {
        if (event.detail > 0) button.blur();
        kindMenu.open = false;
      }
      select(button.dataset.kind || "all");
    }, { signal: controller.signal }));
    if (kindMenu) {
      addEventListener("click", (event) => {
        if (kindMenu.open && !kindMenu.contains(event.target as Node)) kindMenu.open = false;
      }, { signal: controller.signal });
      addEventListener("keydown", (event) => {
        if (event.key === "Escape" && kindMenu.open) {
          kindMenu.open = false;
          kindMenu.querySelector("summary")?.focus();
        }
      }, { signal: controller.signal });
    }
    addEventListener("hashchange", () => {
      void motion.change(() => { fromHash(); requestedKind = kind; apply(); });
    }, { signal: controller.signal });
    fromHash();
    requestedKind = kind;
    apply();
    results.querySelectorAll<HTMLAnchorElement>(".project-open").forEach(link => {
      link.addEventListener("click", () => {
        const from = location.pathname + location.search + location.hash;
        const target = new URL(link.href);
        target.searchParams.set("from", from);
        link.href = target.href;
        try { sessionStorage.setItem("portfolio-browse", JSON.stringify({ from, view: desktopView, scroll: scrollY })); } catch {}
      }, { signal: controller.signal });
    });
    try {
      const saved = JSON.parse(sessionStorage.getItem("portfolio-browse") || "null");
      const restore = sessionStorage.getItem("portfolio-restore") === "true";
      sessionStorage.removeItem("portfolio-restore");
      if (restore && saved?.from === location.pathname + location.search + location.hash) {
        applyLayout(saved.view === "list" ? "list" : "grid");
        requestAnimationFrame(() => requestAnimationFrame(() => scrollTo(0, Number(saved.scroll) || 0)));
      }
    } catch {}
  });
  document.addEventListener("astro:before-swap", () => cleanup());
  addEventListener("popstate", () => {
    if (location.pathname.replace(/\/$/, "").endsWith("/portfolio")) {
      try { sessionStorage.setItem("portfolio-restore", "true"); } catch {}
    }
  });
</script>
