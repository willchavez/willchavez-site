---
import { projectStories } from "../../data/project-stories";
import Base from "../../layouts/Base.astro";
import "../../styles/portfolio.css";
import { portfolioProjects } from "../../data/portfolio-projects";
import { portfolioImg } from "../../lib/content";

export function getStaticPaths() {
  return portfolioProjects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}
const { project } = Astro.props;
const story = projectStories[project.slug];
const related = story?.related ?? (project.slug === "peer-survey" || project.slug === "youtube-redesign" ? { href: "/notes/2026-10-17-starting-again-with-hci", label: "What I learned in HCI" } : project.slug === "nav2" ? { href: "/notes/2025-06-21-making-navigation-feel-like-a-place-to-return", label: "Read about the four-day build" } : undefined);
const labelFor = (label: string) => label.replace(/<[^>]*>/g, "").replace(/[→↗]/g, "").trim();
---
<Base title={project.title} current="portfolio" heading={project.title} sub={project.org} compactTitle description={project.summary}>
  <a class="back" data-project-back href="/portfolio"><svg class="icon-arrow-left" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M12.5 8h-9m0 0 4-4m-4 4 4 4" /></svg>Back to Projects</a>
  <article class="portfolio-project">
    <div class="portfolio-project-category">{project.category}</div>
    <p class="portfolio-project-summary">{project.summary}</p>
    {story && <dl class="portfolio-context"><div><dt>My role</dt><dd>{story.role}</dd></div><div><dt>Project context</dt><dd>{story.status}</dd></div></dl>}
    <figure class="portfolio-cover"><img src={portfolioImg(project.cover, 960)} srcset={`${portfolioImg(project.cover, 480)} 480w, ${portfolioImg(project.cover, 960)} 960w, ${portfolioImg(project.cover, 1600)} 1600w`} sizes="(max-width: 900px) 100vw, 75vw" alt={story?.captions[project.cover] ?? project.images[0]?.alt ?? project.title} fetchpriority="high" decoding="async" /></figure>
    <section class="portfolio-project-copy" aria-label="Project details">
      {story ? <div class="portfolio-story">{story.sections.map(section => <section><h2>{section.title}</h2><p>{section.body}</p></section>)}</div> : <p>{project.about}</p>}
      <h2>My contribution</h2>
      <ul>{project.contributions.map((contribution) => <li>{contribution}</li>)}</ul>
      <div class="portfolio-project-skills" aria-label="Project tags">{project.skills.split(" · ").map((skill) => <span class="skill-tag">{skill}</span>)}</div>
      {project.links.length > 0 && <div class="portfolio-project-links">
        {project.links.map(([url, label]) => <p><a href={url} target="_blank" rel="noreferrer">{labelFor(label)} ↗</a></p>)}
      </div>}
    </section>
    {related && <p class="portfolio-related"><a href={related.href}>{related.label} ↗</a></p>}
    <section class="portfolio-gallery" aria-label="Project images">
      {project.images.filter(image => image.src !== project.cover).map((image) => <figure><img src={portfolioImg(image.src, 960)} srcset={`${portfolioImg(image.src, 480)} 480w, ${portfolioImg(image.src, 960)} 960w, ${portfolioImg(image.src, 1600)} 1600w`} sizes="(max-width: 900px) 100vw, 75vw" alt={story?.captions[image.src] ?? image.alt} loading="lazy" decoding="async" /><figcaption>{story?.captions[image.src] ?? image.alt}</figcaption></figure>)}
    </section>
  </article>
</Base>

<script>
  document.addEventListener("astro:page-load", () => {
    const back = document.querySelector<HTMLAnchorElement>("[data-project-back]");
    if (!back) return;
    const from = new URLSearchParams(location.search).get("from");
    if (!from) return;
    try {
      const target = new URL(from, location.origin);
      const expected = new URL(back.href);
      if (target.origin !== location.origin || target.pathname !== expected.pathname) return;
      back.href = target.href;
      back.addEventListener("click", () => {
        try { sessionStorage.setItem("portfolio-restore", "true"); } catch {}
      }, { once: true });
    } catch {}
  });
</script>
