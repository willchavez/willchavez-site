---
import { portfolioProjects } from '../../../data/portfolio-projects';
import { projectStories } from '../../../data/project-stories';
import { projectPresentations, type PresentationSlide } from '../../../data/project-presentations';
import { portfolioImg } from '../../../lib/content';
import '../../../styles/presentation.css';
export function getStaticPaths() {
  return portfolioProjects.map(project => ({ params: { slug: project.slug }, props: { project } }));
}
const { project } = Astro.props;
const story = projectStories[project.slug];
const deck = projectPresentations[project.slug];
if (!story || !deck) throw new Error(`Missing presentation for ${project.slug}`);
const slides: PresentationSlide[] = [{ section: project.category, title: project.title, body: project.summary }, ...deck.slides];
const images = [...project.images, { src: project.cover, alt: project.title }];
const imageFor = (src: string) => {
  const image = images.find(image => image.src === src);
  if (!image) throw new Error(`Unknown presentation image in ${project.slug}: ${src}`);
  return { ...image, alt: story.captions[src] ?? image.alt };
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{project.title} · Presentation — Will Chavez</title>
    <meta name="description" content={`A presentation of ${project.title}: context, contributions, collaboration, explorations, and outcomes.`} />
    <link rel="canonical" href={new URL(`/portfolio/${project.slug}`, Astro.site ?? 'https://willchavez.com')} />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preload" href="/fonts/source-serif-4-latin.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <header class="deck-toolbar">
      <a class="deck-exit" href={`/portfolio/${project.slug}`} aria-label={`Return to ${project.title} article`}>← Back to project</a>
      <span class="deck-project-name">{project.title}</span>
      <div class="deck-tools">
        <details class="deck-outline"><summary>Slides</summary><nav aria-label="Slide outline">{slides.map((slide, index) => <a href={`#slide-${index + 1}`} data-slide-choice={index}><span>{String(index + 1).padStart(2, '0')}</span>{index === 0 ? 'Title' : slide.section}</a>)}</nav></details>
      </div>
    </header>
    <main class="deck" aria-label={`${project.title} presentation`}>
      {slides.map((slide, index) => <section id={`slide-${index + 1}`} class:list={['slide', index === 0 && 'slide-title', slide.media?.length && 'slide-with-media', slide.media?.length === 2 && 'slide-gallery']} aria-labelledby={`slide-heading-${index + 1}`} data-slide={index} tabindex="-1">
        <div class="slide-copy">
          <p class="slide-section">{slide.section}</p>
          {index === 0 ? <h1 id={`slide-heading-${index + 1}`}>{slide.title}</h1> : <h2 id={`slide-heading-${index + 1}`}>{slide.title}</h2>}
          {slide.body && <p class="slide-body">{slide.body}</p>}
          {slide.points && <ul class="slide-points">{slide.points.map(point => <li>{point}</li>)}</ul>}
          {index === 0 && <div class="slide-intro-meta"><p>Will Chavez <span>· {story.role}</span></p><p>{project.org} <span>· {story.status}</span></p><p class="slide-collaborators">Collaboration: {deck.collaborators}</p></div>}
        </div>
        {slide.media?.length && <div class="slide-media">{slide.media.map(src => {
          const image = imageFor(src);
          return <figure><div class="slide-image-frame"><img src={portfolioImg(image.src, 960)} srcset={`${portfolioImg(image.src, 480)} 480w, ${portfolioImg(image.src, 960)} 960w, ${portfolioImg(image.src, 1600)} 1600w`} sizes="(max-width: 800px) 90vw, 60vw" alt={image.alt} loading="lazy" decoding="async" /></div><figcaption>{image.alt}</figcaption></figure>;
        })}</div>}
        <span class="slide-print-number" aria-hidden="true">{index + 1} / {slides.length}</span>
      </section>)}
    </main>
    <footer class="deck-controls">
      <div class="deck-paging"><button type="button" data-previous aria-label="Previous slide">← <span>Previous</span></button><span class="deck-counter" aria-live="off"><span data-current>1</span> <span aria-hidden="true">/</span> {slides.length}</span><button type="button" data-next aria-label="Next slide"><span>Next</span> →</button></div>
      <div class="deck-progress" role="progressbar" aria-label="Presentation progress" aria-valuemin="1" aria-valuemax={slides.length} aria-valuenow="1"><span></span></div>
    </footer>
    <p class="sr-only" data-slide-announcement role="status" aria-live="polite" aria-atomic="true"></p>
    <script>
      import { initPresentation } from '../../../scripts/presentation';
      initPresentation();
    </script>
  </body>
</html>
