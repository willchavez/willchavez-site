---
import "../styles/base.css";
import "../styles/nav.css";
import "../styles/pages.css";
import Nav from "../components/Nav.astro";
import { ClientRouter } from "astro:transitions";
import { getWriting, getEnjoying } from "../lib/content";

const { title, titleExact = false, current = "work", description = "Will Chavez, design technologist.", heading = "Will Chavez", sub, subKind, subAfter, compactTitle = false, analytics = false, showHeading = true, showPageTitle = true, socialType = "website", structuredData } = Astro.props;
const [w, e] = await Promise.all([getWriting(), getEnjoying()]);
const counts = { notes: w.length, enjoying: e.length };
const pageTitle = title ? (titleExact ? title : `${title} — Will Chavez`) : "Will Chavez — UX Engineer";
const currentYear = new Date().getFullYear();
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? "https://willchavez.com").href;
const personId = "https://willchavez.com/#person";
const siteId = "https://willchavez.com/#website";
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": personId,
      name: "Will Chavez",
      url: "https://willchavez.com/",
      jobTitle: "Design Technologist",
      sameAs: [
        "https://github.com/willchavez",
        "https://www.linkedin.com/in/willchavez/",
        "https://bsky.app/profile/willchavez.bsky.social",
      ],
    },
    {
      "@type": "WebSite",
      "@id": siteId,
      url: "https://willchavez.com/",
      name: "Will Chavez",
      publisher: { "@id": personId },
      inLanguage: "en-US",
    },
    ...(structuredData ? [structuredData] : []),
  ],
};
---
<!doctype html>
<html lang="en" transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="William Chavez" />
    <title>{pageTitle}</title>
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content={socialType} />
    <meta property="og:site_name" content="Will Chavez" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, "\\u003c")} />
    <ClientRouter fallback="swap" />
    <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon" />
    <link rel="alternate" type="application/rss+xml" title="Will Chavez" href="/rss.xml" />
    <link rel="preload" href="/fonts/source-serif-4-latin.woff2" as="font" type="font/woff2" crossorigin />
    {analytics && (<>
      <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-RPXX4TMRSH"></script>
      <script is:inline>
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        gtag("js", new Date());
        gtag("config", "G-RPXX4TMRSH");
      </script>
    </>)}
  </head>
  <body class:list={[showHeading && "content-shell", `route-${current}`]}>
    <Nav current={current} counts={counts} />
    <div class="page-content" transition:name="page-content">
    {showHeading && <div class:list={["page-head", !showPageTitle && "page-head-minimal"]}>
      <div>
        {subKind && <div class="entry-kind"><span class="metadata-kind">{subKind}</span></div>}
        <h1 class:list={[!showPageTitle && "sr-only", compactTitle && "page-title-compact"]}>{heading}</h1>
        <div class:list={["pronouns", subKind && "pronouns-metadata", subAfter && "pronouns-metadata-split"]}>
          {sub && <span class={subAfter ? "metadata-authors" : undefined}>{sub}</span>}
          {subAfter && <span class="metadata-secondary">{subAfter}</span>}
          {!sub && <span>he/him · Design technologist @ Microsoft</span>}
        </div>
      </div>
    </div>}
    <main>
      <slot />
    </main>
    </div>
    <footer class="site-footer">
      <div class="site-footer-bottom">
        <p class="site-copyright">© {currentYear} Will Chavez</p>
        <ul class="social-links">
          <li><a href="https://github.com/willchavez">GitHub</a></li>
          <li><a href="https://www.linkedin.com/in/willchavez/">LinkedIn</a></li>
          <li><a href="https://bsky.app/profile/willchavez.bsky.social">Bluesky</a></li>
          <li><a href="https://www.instagram.com/willchavez/">Instagram</a></li>
        </ul>
      </div>
    </footer>
    <script>
      import "../scripts/site.js";
    </script>
  </body>
</html>
