---
import "../styles/base.css";
import "../styles/nav.css";
import "../styles/pages.css";
import Nav from "../components/Nav.astro";
import { ClientRouter } from "astro:transitions";
import { getWriting, getEnjoying } from "../lib/content";

const { title, current = "work", description = "Will Chavez, design technologist.", heading = "Will Chavez", sub, subKind, compactTitle = false, analytics = false, showHeading = true, showPageTitle = true } = Astro.props;
const [w, e] = await Promise.all([getWriting(), getEnjoying()]);
const counts = { notes: w.length, enjoying: e.length };
const pageTitle = title ? `${title} — Will Chavez` : "Will Chavez — UX Engineer";
---
<!doctype html>
<html lang="en" transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="William Chavez" />
    <title>{pageTitle}</title>
    <ClientRouter fallback="swap" />
    <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon" />
    <link rel="alternate" type="application/rss+xml" title="Will Chavez" href="/rss.xml" />
    <link rel="preload" href="/fonts/source-serif-4-latin.woff2" as="font" type="font/woff2" crossorigin />
    {analytics && (<>
      <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-RPXX4TMRSH"></script>
      <script is:inline>
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        gtag("js", new Date());
        gtag("config", "G-RPXX4TMRSH");
      </script>
    </>)}
  </head>
  <body class:list={[showHeading && "content-shell", `route-${current}`]}>
    <Nav current={current} counts={counts} />
    <div class="page-content" transition:name="page-content">
    {showHeading && <div class:list={["page-head", !showPageTitle && "page-head-minimal"]}>
      <div>
        <h1 class:list={[!showPageTitle && "sr-only", compactTitle && "page-title-compact"]}>{heading}</h1>
        <div class:list={["pronouns", subKind && "pronouns-metadata"]}>
          {subKind && <span class="metadata-kind">{subKind}</span>}
          <span>{sub ?? "he/him · Design technologist @ Microsoft"}</span>
        </div>
      </div>
    </div>}
    <main>
      <slot />
    </main>
    </div>
    <script>
      import "../scripts/site.js";
    </script>
  </body>
</html>
