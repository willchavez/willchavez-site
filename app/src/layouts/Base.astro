---
import "../styles/base.css";
import "../styles/nav.css";
import "../styles/pages.css";
import Nav from "../components/Nav.astro";
import { getWriting, getPhotos, getEnjoying } from "../lib/content";

const { title, current = "work", description = "Will Chavez, design technologist.", heading = "Will Chavez", sub, analytics = false, showHeading = true } = Astro.props;
const [w, p, e] = await Promise.all([getWriting(), getPhotos(), getEnjoying()]);
const counts = { notes: w.length, photos: p.length, enjoying: e.length };
const pageTitle = title ? `${title} — Will Chavez` : "Will Chavez — UX Engineer";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="William Chavez" />
    <title>{pageTitle}</title>
    <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon" />
    <link rel="alternate" type="application/rss+xml" title="Will Chavez" href="/rss.xml" />
    <link rel="preload" href="/fonts/source-serif-4-latin.woff2" as="font" type="font/woff2" crossorigin />
    {analytics && (<>
      <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-RPXX4TMRSH"></script>
      <script is:inline>
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        gtag("js", new Date());
        gtag("config", "G-RPXX4TMRSH");
      </script>
    </>)}
  </head>
  <body class:list={[showHeading && "content-shell", `route-${current}`]}>
    <Nav current={current} counts={counts} />
    {showHeading && <div class="page-head">
      <div>
        <h1>{heading}</h1>
        <div class="pronouns">{sub ?? "he/him · Design technologist @ Microsoft"}</div>
      </div>
    </div>}
    <main>
      <slot />
    </main>
    <script>
      import "../scripts/site.js";
    </script>
  </body>
</html>
