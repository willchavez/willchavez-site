---
import { cardPalettes, type CardColors } from '../data/card-palettes';
const tones = ['ocean', 'aqua', 'butter'];
const vars = (colors: CardColors) => colors.map((c, i) => `--card-${tones[i]}:${c.fill};--card-${tones[i]}-ink:${c.ink};--card-${tones[i]}-muted:${c.muted};--card-${tones[i]}-accent:${c.accent};`).join('');
const rules = (selector: string, light: CardColors, dark: CardColors) => `${selector}{${vars(light)}}@media(prefers-color-scheme:dark){${selector}:not([data-theme="light"]){${vars(dark)}}}${selector}[data-theme="dark"]{${vars(dark)}}`;
const css = rules(':root', cardPalettes[0].light, cardPalettes[0].dark) + cardPalettes.map(p => rules(`:root[data-card-palette="${p.id}"]`, p.light, p.dark)).join('');
---
<style is:inline set:html={css} />
<script is:inline data-card-options={cardPalettes.map(p => p.id).join(',')}>
  (() => {
    const ids = document.currentScript.dataset.cardOptions.split(',');
    let choice = ids[0];
    try { choice = sessionStorage.getItem('will-card-palette') || choice; } catch {}
    document.documentElement.dataset.cardPalette = ids.includes(choice) ? choice : ids[0];
  })();
</script>
<script>
  import '../scripts/card-colors';
</script>
