---
interface Props {
  embed: { src: string; title: string; caption: string; kind: "coffee" | "gallery" };
}
const { embed } = Astro.props;
---
<figure class:list={["project-embed", `project-embed-${embed.kind}`]}>
  <div class="project-embed-frame">
    <iframe src={embed.src} title={embed.title} loading="lazy"></iframe>
  </div>
  <figcaption>{embed.caption}</figcaption>
</figure>
