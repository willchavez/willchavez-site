---
import '../styles/layout-playground.css';
---
<div class="layout-playground" data-layout-playground hidden>
  <div class="layout-options" role="group" aria-label="Choose a layout">
    <button type="button" data-layout-mode="cascade" aria-pressed="true">Cascade</button>
    <button type="button" data-layout-mode="editorial" aria-pressed="false">Editorial</button>
    <button type="button" data-layout-mode="cards" aria-pressed="false">Cards</button>
  </div>
  <p data-layout-description>Different sizes, one flowing grid.</p>
</div>
<script>
  import '../scripts/layout-playground';
</script>
