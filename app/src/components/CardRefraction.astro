<!-- Kept in the document: display:none can break fragment filters in some browsers. -->
<svg width="0" height="0" aria-hidden="true" focusable="false" style="position:absolute;pointer-events:none">
  <defs>
    <filter id="card-refraction" x="-10%" y="-10%" width="120%" height="120%" color-interpolation-filters="sRGB">
      <feTurbulence type="turbulence" baseFrequency="0.003" numOctaves="1" seed="8" result="turbulence" />
      <feDisplacementMap in="SourceGraphic" in2="turbulence" scale="20" xChannelSelector="R" yChannelSelector="G" />
    </filter>
  </defs>
</svg>
<style is:inline>
  .route-about .about-cards .about-card { position: relative; isolation: isolate; overflow: hidden; }
  .route-about .about-cards .about-card::before,
  #enjoying-results[data-view="grid"] #list .ent::before {
    content: ""; position: absolute; inset: 10px; z-index: -1;
    border-radius: inherit; pointer-events: none;
    -webkit-backdrop-filter: url("#card-refraction");
    backdrop-filter: url("#card-refraction");
    transform: rotate(180deg);
  }
  .route-about .about-cards .about-card[data-field-ready]::after,
  #enjoying-results[data-view="grid"] #list .ent[data-field-ready]:not([data-layout-exit])::after {
    content: ""; position: absolute; inset: -12%; z-index: -2; pointer-events: none;
    background-color: inherit; background-image: inherit; background-size: 100% 100%;
    animation: pigment-drift var(--field-duration, 20s) ease-in-out var(--field-delay, 0s) infinite both;
    animation-play-state: paused;
  }
  .route-about .about-cards .about-card[data-field-moving]::after,
  #enjoying-results[data-view="grid"] #list .ent[data-field-moving]:not([data-layout-exit])::after { animation-play-state: running; }
  @keyframes pigment-drift {
    0%, 100% { transform: translate3d(-3%, -2%, 0) rotate(-1.5deg) scale(1.03); }
    35% { transform: translate3d(4%, -1%, 0) rotate(1.4deg) scale(1.06); }
    70% { transform: translate3d(1%, 3.5%, 0) rotate(-.4deg) scale(1.04); }
  }
  @media (prefers-reduced-motion: reduce) {
    .route-about .about-cards .about-card[data-field-ready]::after,
    #enjoying-results[data-view="grid"] #list .ent[data-field-ready]::after { content: none; animation: none; }
  }
</style>
<script>
  import '../scripts/card-field-motion';
</script>
