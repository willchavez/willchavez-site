---
const { current, counts = {}, alignment = "start" } = Astro.props;
const items = [
  { id: "work", label: "Home", href: "/" },
  { id: "portfolio", label: "Projects", href: "/portfolio" },
  { id: "notes", label: "Notes", href: "/notes" },
  { id: "enjoying", label: "Enjoying", href: "/enjoying" },
  { id: "about", label: "About", href: "/about" },
];
const here = items.find((i) => i.id === current) ?? items[0];
---
<div class="topbar" data-current={current} data-alignment={alignment} transition:persist="site-navigation" transition:animate="none">
  <a class="avatar" href="/" aria-label="Will Chavez — home"><img class="portrait" src="/img/will.webp" width="144" height="144" alt="Will Chavez" decoding="async" /></a>
  <nav class="nav" aria-label="Main navigation">
    <details class="pill">
      <summary aria-label={`Open navigation, currently ${here.label}`}>{here.label}</summary>
      <div class="menu">
        {items.map((i) => <a href={i.href} data-count={counts[i.id] || ""} aria-current={i.id === current ? "page" : undefined}>{i.label}</a>)}
      </div>
    </details>
    <div class="desktop-nav">
      {items.map((i) => <a href={i.href} aria-current={i.id === current ? "page" : undefined}><span class="nav-label">{i.label}</span></a>)}
      <div class="nav-selection nav-ink" aria-hidden="true">
        {items.map((i) => <span><span class="nav-ink-label">{i.label}</span></span>)}
      </div>
    </div>
  </nav>
</div>
<script>
  import type { TransitionBeforeSwapEvent } from "astro:transitions/client";
  const topbar = document.querySelector<HTMLElement>(".topbar")!;
  const desktop = topbar.querySelector<HTMLElement>(".desktop-nav")!;
  const menu = topbar.querySelector<HTMLDetailsElement>(".pill")!;
  const ink = desktop.querySelector<HTMLElement>(".nav-ink")!;
  let inkAnimation: Animation | undefined;
  let positionAnimation: Animation | undefined;
  let previousLeft: number | undefined;
  const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)");
  // The background and contrasting labels share one clipping surface. A
  // separate background animation can paint a different frame from the text.
  const syncInk = () => {
    if (!desktop.offsetWidth) return;
    const bounds = ink.getBoundingClientRect();
    const active = desktop.querySelector<HTMLElement>('a[aria-current="page"]')!;
    const pill = active.getBoundingClientRect();
    const padding = getComputedStyle(desktop);
    ink.style.clipPath = `inset(${padding.paddingTop} ${Math.max(0, bounds.right - pill.right)}px ${padding.paddingBottom} ${Math.max(0, pill.left - bounds.left)}px round 999px)`;
    desktop.dataset.ready = "";
  };
  let previousClip: string | undefined;
  const reconcile = () => {
    inkAnimation?.cancel();
    syncInk();
  };
  reconcile();
  new ResizeObserver(reconcile).observe(desktop);
  void document.fonts.ready.then(reconcile);
  reducedMotion.addEventListener("change", () => {
    positionAnimation?.cancel();
    reconcile();
  });
  document.addEventListener("astro:before-swap", (event: TransitionBeforeSwapEvent) => {
    const incoming = event.newDocument.querySelector<HTMLElement>(".topbar");
    if (!incoming) return;
    // Capture the painted position, including an interrupted glide. Layout
    // chooses the destination; animate the persisted bar after the swap.
    previousLeft = topbar.getBoundingClientRect().left;
    topbar.dataset.alignment = incoming.dataset.alignment;
    if (topbar.dataset.current !== incoming.dataset.current) {
      previousClip = getComputedStyle(ink).clipPath;
      inkAnimation?.cancel();
    }
    topbar.dataset.current = incoming.dataset.current;
    topbar.querySelectorAll<HTMLAnchorElement>(".nav a").forEach(link => {
      const next = [...incoming.querySelectorAll<HTMLAnchorElement>(".nav a")].find(a => a.getAttribute("href") === link.getAttribute("href"));
      if (next?.hasAttribute("aria-current")) link.setAttribute("aria-current", "page");
      else link.removeAttribute("aria-current");
      if (next?.hasAttribute("data-count")) link.dataset.count = next.dataset.count;
    });
    const summary = menu.querySelector("summary")!;
    const nextSummary = incoming.querySelector("summary")!;
    summary.textContent = nextSummary.textContent;
    summary.setAttribute("aria-label", nextSummary.getAttribute("aria-label")!);
    menu.open = false;
  });
  // Start after Astro has reinserted the persisted navigation. CSS transitions
  // started before the swap are cancelled when the element is moved.
  document.addEventListener("astro:after-swap", () => {
    positionAnimation?.cancel();
    const destinationLeft = topbar.getBoundingClientRect().left;
    if (previousLeft !== undefined && !reducedMotion.matches) {
      const distance = previousLeft - destinationLeft;
      const body = document.body.getBoundingClientRect();
      // A percentage tracks the bar's width while font styles settle.
      const from = topbar.dataset.alignment === "center"
        ? `translateX(calc(50% + ${previousLeft - body.left - body.width / 2}px))`
        : `translateX(${distance}px)`;
      if (Math.abs(distance) > .5) positionAnimation = topbar.animate([
        { transform: from },
        { transform: "translateX(0)" },
      ], { duration: 420, easing: "cubic-bezier(.22, 1, .36, 1)" });
    }
    previousLeft = undefined;
    syncInk();
    if (previousClip && desktop.offsetWidth && !reducedMotion.matches) {
      const options = { duration: 360, easing: "cubic-bezier(.22, 1, .36, 1)" };
      inkAnimation = ink.animate([
        { clipPath: previousClip! },
        { clipPath: ink.style.clipPath },
      ], options);
    }
    previousClip = undefined;
  });
  // Styles can briefly use fallback metrics while Astro swaps stylesheets.
  // Both text layers lay themselves out identically; refresh the destination
  // once page styles settle without restarting an in-flight mask animation.
  const refreshDestination = () => {
    syncInk();
    if (inkAnimation && ["running", "paused"].includes(inkAnimation.playState)) {
      const frames = (inkAnimation.effect as KeyframeEffect).getKeyframes();
      (inkAnimation.effect as KeyframeEffect).setKeyframes([
        { clipPath: frames[0].clipPath }, { clipPath: ink.style.clipPath },
      ]);
    }
  };
  document.addEventListener("astro:page-load", () => requestAnimationFrame(refreshDestination));
  topbar.addEventListener("click", event => {
    const link = event.target instanceof Element ? event.target.closest<HTMLAnchorElement>("a") : null;
    if (!link || event.button !== 0 || event.metaKey || event.ctrlKey || event.altKey || event.shiftKey) return;
    if (link.getAttribute("aria-current") === "page" && new URL(link.href).pathname.replace(/\/+$/, "") === location.pathname.replace(/\/+$/, "")) event.preventDefault();
    if (event.detail > 0) link.blur();
    menu.open = false;
  });
  document.addEventListener("click", event => {
    if (menu.open && !menu.contains(event.target as Node)) menu.open = false;
  });
  document.addEventListener("keydown", event => {
    if (event.key === "Escape" && menu.open) {
      menu.open = false;
      menu.querySelector("summary")?.focus();
    }
  });
</script>
