---
const { current, counts = {} } = Astro.props;
const items = [
  { id: "work", label: "Home", href: "/" },
  { id: "portfolio", label: "Projects", href: "/portfolio" },
  { id: "notes", label: "Notes", href: "/notes" },
  { id: "enjoying", label: "Enjoying", href: "/enjoying" },
  { id: "about", label: "About", href: "/about" },
];
const here = items.find((i) => i.id === current) ?? items[0];
---
<div class="topbar" data-current={current} transition:persist="site-navigation" transition:animate="none">
  <a class="avatar" href="/" aria-label="Will Chavez — home"><img class="portrait" src="/img/will.webp" width="144" height="144" alt="Will Chavez" decoding="async" /></a>
  <nav class="nav" aria-label="Main navigation">
    <details class="pill">
      <summary aria-label={`Open navigation, currently ${here.label}`}>{here.label}</summary>
      <div class="menu">
        {items.map((i) => <a href={i.href} data-count={counts[i.id] || ""} aria-current={i.id === current ? "page" : undefined}>{i.label}</a>)}
      </div>
    </details>
    <div class="desktop-nav">
      <span class="nav-selection" aria-hidden="true"></span>
      {items.map((i) => <a href={i.href} aria-current={i.id === current ? "page" : undefined}><span class="nav-label">{i.label}</span></a>)}
      <div class="nav-ink" aria-hidden="true">
        {items.map((i) => <span>{i.label}</span>)}
      </div>
    </div>
  </nav>
</div>
<script>
  import type { TransitionBeforeSwapEvent } from "astro:transitions/client";
  const topbar = document.querySelector<HTMLElement>(".topbar")!;
  const desktop = topbar.querySelector<HTMLElement>(".desktop-nav")!;
  const selection = desktop.querySelector<HTMLElement>(".nav-selection")!;
  const menu = topbar.querySelector<HTMLDetailsElement>(".pill")!;
  const ink = desktop.querySelector<HTMLElement>(".nav-ink")!;
  let selectionAnimation: Animation | undefined;
  let inkAnimation: Animation | undefined;
  const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)");
  const clipForSelection = () => {
    const bounds = ink.getBoundingClientRect();
    const pill = selection.getBoundingClientRect();
    return `inset(${Math.max(0, pill.top - bounds.top)}px ${Math.max(0, bounds.right - pill.right)}px ${Math.max(0, bounds.bottom - pill.bottom)}px ${Math.max(0, pill.left - bounds.left)}px round 999px)`;
  };
  // As on main, duplicate only the visible text and clip the light copy to the
  // pill. aria-current updates semantics without switching either label color.
  const syncInk = () => {
    if (!desktop.offsetWidth) return;
    const bounds = ink.getBoundingClientRect();
    const labels = desktop.querySelectorAll<HTMLElement>(".nav-label");
    ink.querySelectorAll<HTMLElement>("span").forEach((label, index) => {
      const rect = labels[index].getBoundingClientRect();
      label.style.left = `${rect.left - bounds.left}px`;
      label.style.top = `${rect.top - bounds.top}px`;
    });
    ink.style.clipPath = clipForSelection();
    desktop.dataset.ready = "";
  };
  const positionSelection = () => {
    const active = desktop.querySelector<HTMLElement>('a[aria-current="page"]');
    if (!active || !desktop.offsetWidth) return;
    selection.style.width = `${active.offsetWidth}px`;
    selection.style.height = `${active.offsetHeight}px`;
    selection.style.transform = `translate(${active.offsetLeft}px, ${active.offsetTop}px)`;
  };
  let previousSelection: { transform: string; width: string } | undefined;
  let previousClip: string | undefined;
  const reconcile = () => {
    selectionAnimation?.cancel();
    inkAnimation?.cancel();
    positionSelection();
    syncInk();
  };
  reconcile();
  new ResizeObserver(reconcile).observe(desktop);
  void document.fonts.ready.then(reconcile);
  reducedMotion.addEventListener("change", reconcile);
  document.addEventListener("astro:before-swap", (event: TransitionBeforeSwapEvent) => {
    const incoming = event.newDocument.querySelector<HTMLElement>(".topbar");
    if (!incoming) return;
    if (topbar.dataset.current !== incoming.dataset.current) {
      const style = getComputedStyle(selection);
      previousSelection = { transform: style.transform, width: style.width };
      previousClip = clipForSelection();
      selectionAnimation?.cancel();
      inkAnimation?.cancel();
    }
    topbar.dataset.current = incoming.dataset.current;
    topbar.querySelectorAll<HTMLAnchorElement>(".nav a").forEach(link => {
      const next = [...incoming.querySelectorAll<HTMLAnchorElement>(".nav a")].find(a => a.getAttribute("href") === link.getAttribute("href"));
      if (next?.hasAttribute("aria-current")) link.setAttribute("aria-current", "page");
      else link.removeAttribute("aria-current");
      if (next?.hasAttribute("data-count")) link.dataset.count = next.dataset.count;
    });
    const summary = menu.querySelector("summary")!;
    const nextSummary = incoming.querySelector("summary")!;
    summary.textContent = nextSummary.textContent;
    summary.setAttribute("aria-label", nextSummary.getAttribute("aria-label")!);
    menu.open = false;
    positionSelection();
  });
  // Start after Astro has reinserted the persisted navigation. CSS transitions
  // started before the swap are cancelled when the element is moved.
  document.addEventListener("astro:after-swap", () => {
    positionSelection();
    syncInk();
    if (previousSelection && desktop.offsetWidth && !reducedMotion.matches) {
      const options = { duration: 360, easing: "cubic-bezier(.22, 1, .36, 1)" };
      selectionAnimation = selection.animate([
        previousSelection,
        { transform: selection.style.transform, width: selection.style.width },
      ], options);
      inkAnimation = ink.animate([
        { clipPath: previousClip! },
        { clipPath: ink.style.clipPath },
      ], options);
      // Use the same timeline time so the mask never trails the background.
      const started = document.timeline.currentTime;
      if (typeof started === "number") {
        selectionAnimation.startTime = started;
        inkAnimation.startTime = started;
      }
    }
    previousSelection = undefined;
    previousClip = undefined;
  });
  topbar.addEventListener("click", event => {
    const link = event.target instanceof Element ? event.target.closest<HTMLAnchorElement>("a") : null;
    if (!link || event.button !== 0 || event.metaKey || event.ctrlKey || event.altKey || event.shiftKey) return;
    if (link.getAttribute("aria-current") === "page" && new URL(link.href).pathname.replace(/\/+$/, "") === location.pathname.replace(/\/+$/, "")) event.preventDefault();
    if (event.detail > 0) link.blur();
    menu.open = false;
  });
  document.addEventListener("click", event => {
    if (menu.open && !menu.contains(event.target as Node)) menu.open = false;
  });
  document.addEventListener("keydown", event => {
    if (event.key === "Escape" && menu.open) {
      menu.open = false;
      menu.querySelector("summary")?.focus();
    }
  });
</script>
