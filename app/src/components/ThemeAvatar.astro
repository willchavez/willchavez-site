---
import '../styles/theme-avatar.css';
---
<button class="avatar theme-avatar" type="button" data-theme-toggle aria-label="Switch to dark mode" aria-pressed="false" title="Switch to dark mode" hidden>
  <span class="avatar-scene" aria-hidden="true">
    <svg class="avatar-stars" viewBox="0 0 100 100"><g fill="#fff0ba"><path d="m68 11 1.8 4.2 4.2 1.8-4.2 1.8-1.8 4.2-1.8-4.2-4.2-1.8 4.2-1.8Z"/><path d="m85 37 1.3 3.2 3.2 1.3-3.2 1.3-1.3 3.2-1.3-3.2-3.2-1.3 3.2-1.3Z"/><circle cx="43" cy="10" r="1.1"/><circle cx="12" cy="43" r="1.1"/><circle cx="80" cy="24" r="1"/></g></svg>
    <svg class="avatar-cloud" viewBox="0 0 100 100"><path fill="#fff1d5" d="M69 31a6 6 0 0 1 2-11 8 8 0 0 1 15 1 5 5 0 0 1 2 10Z"/></svg>
    <svg class="avatar-orbit" viewBox="0 0 100 100">
      <g class="avatar-sun" fill="#ffd04d" stroke="#ffd04d" stroke-width="2" stroke-linecap="round">
        <circle cx="23" cy="25" r="8" stroke="none"/>
        <path d="M23 12v-3m0 32v-3M10 25H7m32 0h-3M14 16l-2-2m22 22-2-2M14 34l-2 2m22-22-2 2"/>
      </g>
      <g class="avatar-moon" transform="translate(65 93) rotate(180 12 12)"><path fill="#ffedb6" d="M21 12.79A9 9 0 1 1 11.21 3a7 7 0 0 0 9.79 9.79Z"/></g>
    </svg>
    <svg class="avatar-hills" viewBox="0 0 100 100"><path class="avatar-hill-back" d="M0 73Q20 60 49 76T100 68V100H0Z"/><path class="avatar-hill-front" d="M0 86Q26 70 58 84T100 78V100H0Z"/></svg>
    <img class="avatar-character" src="/avatars/will-theme.webp" width="1024" height="1024" alt="" decoding="async" fetchpriority="high" />
  </span>
</button>
<a class="avatar avatar-fallback" data-theme-fallback href="/" aria-label="Will Chavez — home"><img class="portrait" src="/img/will.webp" width="144" height="144" alt="Will Chavez" decoding="async" /></a>
