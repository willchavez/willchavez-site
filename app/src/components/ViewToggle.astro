---
import '../styles/view-toggle.css';
interface Props { label: string; className?: string; hidden?: boolean }
const { label, className, hidden = false } = Astro.props;
---
<div class:list={["view-toggle", className]} role="group" aria-label={label} hidden={hidden}>
  <button type="button" data-layout-choice="grid" aria-label="Grid view" aria-pressed="true">
    <svg viewBox="0 0 20 20" aria-hidden="true"><rect x="2.5" y="2.5" width="6" height="6" rx="1"/><rect x="11.5" y="2.5" width="6" height="6" rx="1"/><rect x="2.5" y="11.5" width="6" height="6" rx="1"/><rect x="11.5" y="11.5" width="6" height="6" rx="1"/></svg><span>Grid</span>
  </button>
  <button type="button" data-layout-choice="list" aria-label="List view" aria-pressed="false">
    <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M7.5 4h10M7.5 10h10M7.5 16h10"/><circle cx="3.5" cy="4" r=".8"/><circle cx="3.5" cy="10" r=".8"/><circle cx="3.5" cy="16" r=".8"/></svg><span>List</span>
  </button>
</div>
