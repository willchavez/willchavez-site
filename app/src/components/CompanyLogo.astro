---
import microsoft from "../assets/brands/microsoft.svg?raw";
import ibm from "../assets/brands/ibm.svg?raw";
import lockheed from "../assets/brands/lockheed-martin.svg?raw";
const marks = { microsoft, ibm, "lockheed-martin": lockheed };
interface Props { company: keyof typeof marks }
const { company } = Astro.props;
---
<span class:list={["work-logo", `work-logo-${company}`]} aria-hidden="true" set:html={marks[company]} />

<style>
  /* Use Lockheed’s reversed mark on dark cards; the multicolor marks stay intact. */
  @media (prefers-color-scheme: dark) {
    .work-logo-ibm {
      --ibm-blue: #0f62fe;
      --ibm-iris: #a9472e;
      --ibm-brow: #e2231a;
      --ibm-eyes: #f4adca;
      --ibm-wings: #6b8d3a;
      --ibm-gold: #ffb52e;
    }
    .work-logo-lockheed-martin :global(svg) { fill: #fff; }
  }
</style>
