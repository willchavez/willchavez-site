<!-- Resolve before paint. Manual choices last for this visit, not forever. -->
<script is:inline>
  (() => {
    let preference = window.willThemePreference;
    if (preference === undefined) {
      try {
        const navigation = performance.getEntriesByType('navigation')[0];
        const internalReferrer = document.referrer && new URL(document.referrer).origin === location.origin;
        // Reloads and full internal navigation continue the visit. A fresh
        // entry from outside the site starts with the device preference.
        if (navigation?.type === 'navigate' && !internalReferrer) sessionStorage.removeItem('will-theme');
        preference = sessionStorage.getItem('will-theme');
      } catch {}
    }
    window.willThemePreference = preference === 'light' || preference === 'dark' ? preference : null;
    document.documentElement.dataset.theme = window.willThemePreference || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
  })();
</script>
<script>
  import '../scripts/theme';
</script>
<style is:global>
  :root[data-theme="light"] { color-scheme: light; }
  :root[data-theme="dark"] { color-scheme: dark; }
</style>
